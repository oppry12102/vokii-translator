<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_mic" />

        <TextView
            android:id="@+id/status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/hint_speak"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

    <!-- Transcript card: per-turn cards inside a scroll container.
         Committed cards are immutable — only the bottom "active" card
         updates in place, and a chase scroller glides (never jumps) to
         the bottom, so on-screen lines stay put. -->
    <LinearLayout
        android:id="@+id/transcript_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/status_hint">

        <ScrollView
            android:id="@+id/scroll_transcript"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/turns_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- One-line status hint under the transcript. Voice-command results
         ("» Display → target only") surface here instead of cluttering the
         conversation text. Fixed height so it never shifts the layout when
         a message arrives; tap = UNDO the last undoable command. -->
    <TextView
        android:id="@+id/status_hint"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginHorizontal="14dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toTopOf="@id/mic_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Mic control area -->
    <FrameLayout
        android:id="@+id/mic_area"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toTopOf="@id/debug_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic"
            android:contentDescription="Microphone"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <!-- Debug panel (hidden by default; toggled in Settings).
         320dp gives ~7 visible log lines at 11sp after the header and
         test-inject row — the inject panel is hidden when the panel
         itself is gone, so non-debug users see no extra UI. -->
    <LinearLayout
        android:id="@+id/debug_panel"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:orientation="vertical"
        android:background="@drawable/bg_debug"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_debug"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_debug"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/action_clear"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/debug_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/debug_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/debug_text"
                android:textSize="11sp"
                tools:text="[init]\nasr=ok" />
        </ScrollView>

        <!-- Test injector (only meaningful when asr is CascadeEngine).
             Bypasses the ASR step and feeds text directly to the MT LLM,
             so the full tool_use / dispatch / UI chain is exercised
             without needing the mic. The panel is part of debug_panel
             (gone by default), so users who don't open Debug never see
             it. -->
        <LinearLayout
            android:id="@+id/inject_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:paddingTop="6dp"
            android:background="#22FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test inject (skips ASR, hits MT directly)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <EditText
                    android:id="@+id/inject_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="e.g. 下面改成中日翻译"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:autofillHints=""
                    android:maxLines="1"
                    android:imeOptions="actionDone" />

                <Button
                    android:id="@+id/btn_inject"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Inject"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <Button
                    android:id="@+id/preset_lang"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="set_langs"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_display"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="set_display"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_cascade"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="toggle_cascade"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_debug"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="toggle_debug"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_style"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="set_style"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_get"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="get"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_temp"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="temp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_clear"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="clear"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <Button
                    android:id="@+id/preset_mic"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="mic"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_log"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="log"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_export"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="export"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_summary"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="summary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_retranslate"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="re-tx"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/preset_help"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="help"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
