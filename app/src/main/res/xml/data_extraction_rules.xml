<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Exclude vokii_prefs (holds the user's optional
     API-key override from Settings) from both cloud backup and device transfer
     so it never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vokii_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vokii_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
