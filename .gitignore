# --- Built artifacts ---
*.apk
*.aab
*.ap_
*.dex

# --- Gradle ---
.gradle/
build/
local.properties
# Per Android Studio convention: gradle wrapper jar is generated, not committed.
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
.vscode/
captures/

# --- Secrets ---
# local.properties is the only secret-bearing file in the repo. It is
# already gitignored above. The DEEPSEEK_API_KEY it contains is read at
# configuration time by app/build.gradle and compiled into BuildConfig.
# Anyone who decompiles the APK can recover it; that is the trade-off
# for shipping a working default with the binary. Rotate the key if the
# APK is shared publicly.
app/agconnect-services.json
app/src/main/assets/agconnect-services.json
app/build/generated/agconnect-services.json

# --- OS noise ---
.DS_Store
Thumbs.db
