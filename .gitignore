# --- Built artifacts ---
*.apk
*.aab
*.ap_
*.dex

# --- Gradle ---
.gradle/
build/
local.properties
# The gradle-wrapper jar IS committed (it makes the build reproducible without
# a preinstalled Gradle). The negation below is a no-op now (nothing above
# ignores it), kept for clarity so a future broad ignore can't silently drop it.
!gradle/wrapper/gradle-wrapper.jar

# --- Signing identity ---
# The release keystore and its secrets never belong in version control. The
# keystore file used to be committed (burning the app's signing identity);
# secrets moved to local.properties. Both are gitignored here. See the security
# note in app/build.gradle and the S1 fix note.
keystore/
*.jks

# --- IDE ---
.idea/
*.iml
.vscode/
captures/

# --- Secrets ---
# local.properties is the only secret-bearing file in the repo. It is
# already gitignored above. The QWEN_API_KEY it contains is read at
# configuration time by app/build.gradle and compiled into BuildConfig.
# Anyone who decompiles the APK can recover it; that is the trade-off
# for shipping a working default with the binary. Rotate the key if the
# APK is shared publicly.
app/agconnect-services.json
app/src/main/assets/agconnect-services.json
app/build/generated/agconnect-services.json

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Python (eval harness) ---
__pycache__/
*.pyc
